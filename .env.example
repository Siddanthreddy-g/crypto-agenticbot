# ───────────── SAFETY ─────────────
# This build is PAPER-ONLY. Any other value is rejected at startup.
TRADING_MODE=paper

# ───────────── MARKET DATA ─────────────
# exchange: public ccxt data (no API key needed).  synthetic: offline demo feed.
DATA_SOURCE=exchange
# Any ccxt spot exchange id. Use binanceus / bybit / okx / kraken if Binance is
# blocked in your region.
EXCHANGE_ID=binance
QUOTE_ASSET=USDT
TIMEFRAME=5m
CANDLE_LIMIT=300
SCAN_INTERVAL_SECONDS=30
MAX_SYMBOLS=15
MIN_QUOTE_VOLUME_USDT=5000000
# Optional fixed list instead of auto-scanning, e.g. BTC/USDT,ETH/USDT,SOL/USDT
WATCHLIST=

# ───────────── PAPER ACCOUNT / FEES ─────────────
INITIAL_CASH_USDT=100
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
MIN_NOTIONAL_USDT=10

# ───────────── RISK (hard limits, enforced in code, never by the LLM) ─────────────
RISK_PER_TRADE=0.005
MAX_POSITION_FRACTION=0.25
MAX_TOTAL_EXPOSURE=0.60
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_CONSECUTIVE_LOSSES=3
LOSS_PAUSE_MINUTES=60
SYMBOL_COOLDOWN_CANDLES=6
MAX_HOLD_CANDLES=48

# ───────────── STRATEGY ─────────────
RSI_MIN=50
RSI_MAX=68
VOLUME_MULTIPLIER=1.2
ATR_STOP_MULT=1.5
REWARD_RISK=2.0
MIN_STOP_PCT=0.008
MAX_STOP_PCT=0.03
MAX_COST_TO_TARGET=0.35
MIN_NET_RR=1.1

# ───────────── LLM (optional - the bot is fully functional and FREE without it) ─────────────
# The LLM can only APPROVE / REDUCE / REJECT rule-based signals (and, if the scout is on, NOMINATE extra
# candidates). It can never set prices, stops, sizes or limits. Leave LLM_ENABLED=false to pay/use nothing.
LLM_ENABLED=false

# ---- FREE option 1: Ollama on your own PC (no account, no key, no limits) ----
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=trader            # a model you created from ollama (see README); any local model name works
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=180     # CPU-only PCs are slow
#
# ---- FREE option 2: Groq free tier (account, no card) ----
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-groq-key
#
# ---- FREE option 3: Google Gemini free tier via AI Studio (account, no card) ----
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<a current Flash model name from AI Studio>
# LLM_API_KEY=your-ai-studio-key
#
# ---- PAID option: Anthropic API (not needed; costs money) ----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=90
ANTHROPIC_API_KEY=
# What to do if the LLM call fails: reject (safe) | approve (fall back to rules)
LLM_FAIL_MODE=reject
# Free tiers have rate limits - keep this modest for them
LLM_MAX_CALLS_PER_HOUR=30
LLM_MIN_CONFIDENCE=0.5
DAILY_LLM_REVIEW=true

# ───────────── LLM SCOUT (optional, needs the LLM settings above) ─────────────
# The LLM may NOMINATE extra long candidates the rules missed. Code still computes stop/target (ATR),
# applies the fee gate and every risk limit; scout trades are smaller and capped, and tagged 'llm_scout'
# so the dashboard shows their results separately from the rules.
LLM_SCOUT_ENABLED=true
# Leave empty to reuse LLM_MODEL. (On free tiers keep the interval >= 30 minutes to stay inside rate limits.)
LLM_SCOUT_MODEL=
LLM_SCOUT_INTERVAL_MINUTES=15
LLM_SCOUT_MIN_CONFIDENCE=0.65
LLM_SCOUT_SIZE_FACTOR=0.5
LLM_SCOUT_MAX_TRADES_PER_DAY=4
LLM_SCOUT_MAX_CONCURRENT=1

# ───────────── TELEGRAM ALERTS (optional) ─────────────
# Create a NEW bot token via @BotFather. Never hardcode it in source.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───────────── FILES ─────────────
DATABASE_PATH=trader.db
KILL_SWITCH_FILE=KILL_SWITCH
LOG_LEVEL=INFO
